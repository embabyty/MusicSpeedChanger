<Window
    x:Class="MusicSpeedChanger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicSpeedChanger.Controls"
    Title="Music Speed Changer">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: transparent so the Mica backdrop shows through.
             Set as the draggable title-bar region in code-behind. -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="ms-appx:///Assets/MusicSpeed.png" Width="16" Height="16"
                       Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Music Speed Changer" VerticalAlignment="Center"
                           Foreground="#E8E8F0" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

    <Border Grid.Row="1" Padding="12">
    <Grid>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#2A2A3A" />
                <Setter Property="Foreground" Value="#E8E8F0" />
                <Setter Property="BorderBrush" Value="#3D3D55" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="Margin" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBlock" x:Key="ValueLabel">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="MinWidth" Value="90" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
            <Style TargetType="TextBlock" x:Key="CardHeader">
                <Setter Property="Foreground" Value="#B8B8D0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="OpenButton" Content="&#x1F4C2; Open�" Click="OpenButton_Click" FontWeight="SemiBold" />
            <Button x:Name="ExportButton" Content="&#x1F4BE; Export WAV�" Click="ExportButton_Click" IsEnabled="False" />
            <Button x:Name="SettingsButton" Content="? Settings" Click="SettingsButton_Click" />
            <TextBlock x:Name="FileLabel" Text="No file loaded" VerticalAlignment="Center" Margin="12,0"
                       Foreground="#B8B8D0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusLabel" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#7C9EFF" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Queue sidebar -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,6,6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Queue" Style="{StaticResource CardHeader}" />
                    <ListView Grid.Row="1" x:Name="FileListView" SelectionMode="Single"
                              SelectionChanged="FileListView_SelectionChanged"
                              AllowDrop="True" DragOver="FileList_DragOver" Drop="FileList_Drop"
                              KeyDown="FileListView_KeyDown">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="＋ Add" Click="AddFilesButton_Click" Padding="8,2" />
                        <Button Content="－" Click="RemoveFileButton_Click" Padding="8,2">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Remove selected" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Content="Clear" Click="ClearFilesButton_Click" Padding="8,2" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Drop audio files here"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E28" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,6">
                <controls:WaveformControl x:Name="Waveform" SeekRequested="Waveform_SeekRequested" />
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tempo -->
                <Border x:Name="TempoCard" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="6" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Tempo (speed, keeps pitch)" Style="{StaticResource CardHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="TempoSlider" Minimum="25" Maximum="200" Value="100"
                                    Width="170" TickFrequency="5" StepFrequency="1"
                                    ValueChanged="TempoSlider_ValueChanged" />
                            <TextBlock x:Name="TempoLabel" Text="100%" Style="{StaticResource ValueLabel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="0.5x" Tag="50" Click="TempoPreset_Click" Padding="8,2" />
                            <Button Content="0.75x" Tag="75" Click="TempoPreset_Click" Padding="8,2" />
                            <Button Content="1x" Tag="100" Click="TempoPreset_Click" Padding="8,2" />
                            <Button Content="1.25x" Tag="125" Click="TempoPreset_Click" Padding="8,2" />
                            <Button Content="1.5x" Tag="150" Click="TempoPreset_Click" Padding="8,2" />
                        </StackPanel>
                        <Button Content="Reset tempo" Click="ResetTempo_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Pitch -->
                <Border x:Name="PitchCard" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="6" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Pitch (key, keeps tempo)" Style="{StaticResource CardHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="0"
                                    Width="170" TickFrequency="0.5" StepFrequency="0.1"
                                    ValueChanged="PitchSlider_ValueChanged" />
                            <TextBlock x:Name="PitchLabel" Text="+0.0 st" Style="{StaticResource ValueLabel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="-5" Tag="-5" Click="PitchPreset_Click" Padding="8,2" />
                            <Button Content="-2" Tag="-2" Click="PitchPreset_Click" Padding="8,2" />
                            <Button Content="0" Tag="0" Click="PitchPreset_Click" Padding="8,2" />
                            <Button Content="+2" Tag="2" Click="PitchPreset_Click" Padding="8,2" />
                            <Button Content="+5" Tag="5" Click="PitchPreset_Click" Padding="8,2" />
                        </StackPanel>
                        <Button Content="Reset pitch" Click="ResetPitch_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Loop -->
                <Border x:Name="LoopCard" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="6" Padding="8">
                    <StackPanel>
                        <TextBlock Text="AB Loop (practice sections)" Style="{StaticResource CardHeader}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="SetAButton" Content="Set A" Click="SetAButton_Click" IsEnabled="False" />
                            <Button x:Name="SetBButton" Content="Set B" Click="SetBButton_Click" IsEnabled="False" />
                            <Button x:Name="ClearLoopButton" Content="Clear" Click="ClearLoopButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="LoopLabel" Text="No loop set" HorizontalAlignment="Center"
                                   Foreground="#FFC107" Margin="0,4" />
                        <CheckBox x:Name="LoopCheckBox" Content="Loop A�B" IsEnabled="False"
                                  Foreground="#E8E8F0" HorizontalAlignment="Center"
                                  Checked="LoopCheckBox_Changed" Unchecked="LoopCheckBox_Changed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 31-band equalizer -->
            <Border x:Name="EqCard" Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="6" Padding="8">
                <StackPanel>
                    <TextBlock Text="31-Band Equalizer (20 Hz � 20 kHz)" Style="{StaticResource CardHeader}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <CheckBox x:Name="EqEnableCheckBox" Content="Enable EQ" IsChecked="True"
                                  Foreground="#E8E8F0" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="EqEnableCheckBox_Changed" Unchecked="EqEnableCheckBox_Changed" />
                        <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B8B8D0" />
                        <ComboBox x:Name="EqPresetBox" Width="150" SelectionChanged="EqPresetBox_SelectionChanged" />
                        <Button Content="Flat" Click="EqFlatButton_Click" Padding="12,2" />
                        <TextBlock x:Name="EqHintLabel" Text="+/-15 dB per band, 1 dB steps"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#77778A" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="EqBandsPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- Time row -->
        <Grid Grid.Row="2" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="CurrentTimeLabel" Text="0:00.0" Foreground="#E8E8F0" />
            <Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0"
                    HorizontalAlignment="Stretch" ValueChanged="SeekSlider_ValueChanged" />
            <TextBlock Grid.Column="2" x:Name="TotalTimeLabel" Text="0:00.0" TextAlignment="Right" Foreground="#E8E8F0" />
            <TextBlock Grid.Column="3" x:Name="EffectiveTimeLabel" Text="" Foreground="#7C9EFF" Margin="8,0,0,0" />
        </Grid>

        <!-- Transport bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="PrevButton" Content="&#x23EE; Prev" Click="PrevButton_Click" IsEnabled="False" FontSize="14" Padding="20,8" />
            <Button x:Name="PlayButton" Content="? Play" Click="PlayButton_Click" IsEnabled="False"
                    FontSize="14" Padding="20,8" Background="#2E7D32" BorderBrush="#2E7D32" />
            <Button x:Name="StopButton" Content="? Stop" Click="StopButton_Click" IsEnabled="False" FontSize="14" Padding="20,8" />
            <Button x:Name="NextButton" Content="Next &#x23ED;" Click="NextButton_Click" IsEnabled="False" FontSize="14" Padding="20,8" />
            <Button x:Name="ReverseButton" Content="? Reverse" Click="ReverseButton_Click" IsEnabled="False"
                    FontSize="14" Padding="20,8">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Play backwards from the current position" />
                </ToolTipService.ToolTip>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="&#x1F50A;" VerticalAlignment="Center" />
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="120"
                        ValueChanged="VolumeSlider_ValueChanged" />
            </StackPanel>
        </StackPanel>
    </Grid>
    </Border>
    </Grid>
</Window>
