<ContentDialog
    x:Class="MusicSpeedChanger.AutoMixDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AutoMix &amp; Transitions"
    CloseButtonText="Close">

    <ScrollViewer MaxHeight="620">
        <StackPanel MinWidth="520" Spacing="8" Margin="0,0,8,0">

            <!-- Outgoing track -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="6" Background="#23232E">
                    <TextBlock x:Name="OutArtLetter" Text="♪" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="OutTitle" Text="—" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="OutArtist" Text="" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="OutBpm" Text="— BPM" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="OutDuration" Text="" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Mix view: outgoing (top) + incoming (bottom) waveforms, mix zone, preview -->
            <Grid>
                <Image x:Name="MixImage" Height="220" Stretch="Fill" />
                <Button x:Name="PreviewButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                        Width="56" Height="56" CornerRadius="28"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="PreviewButton_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Preview the transition now" />
                    </ToolTipService.ToolTip>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <ComboBox x:Name="BarsBox" PlaceholderText="Bars" Width="140"
                          SelectionChanged="BarsBox_SelectionChanged">
                    <x:String>1 bar</x:String>
                    <x:String>2 bars</x:String>
                    <x:String>4 bars</x:String>
                    <x:String>8 bars</x:String>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="PreviewStatusLabel" TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />

            <!-- Incoming track -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="6" Background="#23232E">
                    <TextBlock x:Name="InArtLetter" Text="♪" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="InTitle" Text="—" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InArtist" Text="" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="InBpm" Text="— BPM" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="InDuration" Text="" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Border Height="1" Margin="0,4" Background="#2A2A35" />

            <!-- Customization (moved here from Settings / flyout) -->
            <ToggleSwitch x:Name="EnableToggle" Header="AutoMix crossfade"
                          Toggled="EnableToggle_Toggled" />
            <Grid>
                <TextBlock Text="Crossfade duration" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DurationValueLabel" Text="5.0s" FontSize="12"
                           HorizontalAlignment="Right" FontWeight="SemiBold" />
            </Grid>
            <Slider x:Name="DurationSlider" Minimum="1" Maximum="12" StepFrequency="0.5" Value="5"
                    ValueChanged="DurationSlider_ValueChanged" Margin="0,-6,0,0" />

            <TextBlock Text="Transition style" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0" />
            <RadioButton x:Name="StyleBassSwap" GroupName="MixStyle" Tag="BassSwap"
                         Checked="StyleRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Bass Swap (DJ EQ)" FontWeight="SemiBold" />
                    <TextBlock Text="Swaps bass frequencies at the mix point to prevent muddy low-end clashing (Spotify/DJ style)."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="StyleBlend" GroupName="MixStyle" Tag="Blend"
                         Checked="StyleRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Equal Power Blend" FontWeight="SemiBold" />
                    <TextBlock Text="Smooth constant-volume acoustic blend between tracks."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="StyleRise" GroupName="MixStyle" Tag="Rise"
                         Checked="StyleRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Rise / High-Pass" FontWeight="SemiBold" />
                    <TextBlock Text="Sweeps a high-pass filter upward on the outgoing song, creating tension into the drop."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="StyleBeatDrop" GroupName="MixStyle" Tag="BeatDrop"
                         Checked="StyleRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Beat Drop" FontWeight="SemiBold" />
                    <TextBlock Text="Plays the outgoing track until the downbeat, then cuts sharply into the new song."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="StyleLinear" GroupName="MixStyle" Tag="Linear"
                         Checked="StyleRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Linear" FontWeight="SemiBold" />
                    <TextBlock Text="Standard direct linear crossfade."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>

            <CheckBox x:Name="BeatSyncBox" Content="Match tempo &amp; downbeats (Beat-Sync)"
                      Click="OptionBox_Click" Margin="0,4,0,0" />
            <CheckBox x:Name="SkipSilenceBox" Content="Smart Cue: skip leading silence"
                      Click="OptionBox_Click" Margin="0,-4,0,0" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
